def xor_decrypt(ciphertext_bytes, key):
    key_ext = (key * (len(ciphertext_bytes) // len(key) + 1))[:len(ciphertext_bytes)]
    return "".join(chr(b ^ ord(k)) for b, k in zip(ciphertext_bytes, key_ext))

data = open('flag.txt.enc', 'rb').read()
print(xor_decrypt(data, "rapscallion"))
