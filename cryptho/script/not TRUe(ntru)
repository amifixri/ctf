Chall ini adalah NTRU Lattice Attack:
NTRU itu apa?
Enkripsi berbasis polinomial. 
Private key-nya f dan g — polinomial dengan koefisien kecil (-1, 0, 1). Public key h = p * f⁻¹ * g mod q.

NTRU Ciri di soal:

Ada variabel N, p, q tapi N kecil (biasanya < 100)
Ada PolynomialRing, quotient(x^N - 1) di source
Private key berupa polinomial koefisien kecil (randint(-1, 1))
Public key h = p * f_inv * g mod q
Hint biasanya nyebut "lattice"
Debug info format u:xxx e:xxx p:xxx → itu parameter NTRU

Kata kunci di source code: R_modq, R_modp, gen_poly(), f_q_inv, f_p_inv



from sage.all import *

N = 48
p = 3
q = 509

h = [311, 273, 153, 392, 105, 426, 45, 159, 421, 30, 404, 38, 313, 480, 37, 195, 82, 382, 236, 230, 340, 66, 199, 121, 279, 273, 271, 22, 270, 227, 26, 253, 213, 408, 323, 263, 283, 168, 88, 164, 383, 247, 5, 313, 150, 170, 89, 235]
ct = [[231, 6, 348, 205, 488, 156, 57, 466, 295, 240, 87, 285, 165, 208, 343, 426, 410, 36, 190, 110, 187, 28, 237, 262, 508, 111, 451, 311, 128, 449, 476, 434, 159, 98, 488, 399, 314, 499, 427, 325, 299, 250, 457, 8, 64, 423, 210, 271], [177, 217, 101, 452, 354, 388, 158, 437, 435, 484, 452, 0, 142, 47, 66, 229, 131, 325, 423, 394, 337, 356, 8, 56, 197, 12, 456, 186, 430, 286, 68, 106, 271, 257, 351, 76, 508, 383, 360, 318, 426, 113, 84, 451, 436, 206, 63, 151], [212, 400, 162, 356, 300, 494, 60, 333, 230, 477, 484, 174, 26, 65, 175, 107, 158, 496, 168, 318, 350, 497, 261, 281, 388, 193, 16, 294, 180, 390, 116, 252, 169, 411, 69, 257, 496, 302, 86, 320, 405, 436, 156, 462, 219, 486, 349, 494], [275, 256, 300, 153, 467, 412, 380, 353, 435, 232, 450, 490, 136, 136, 86, 326, 93, 19, 208, 89, 474, 163, 70, 30, 56, 261, 145, 499, 49, 403, 331, 315, 49, 472, 66, 156, 26, 481, 412, 258, 503, 44, 275, 222, 164, 356, 212, 57], [354, 310, 412, 400, 67, 433, 363, 209, 80, 244, 473, 239, 409, 446, 356, 193, 191, 15, 443, 79, 371, 63, 444, 285, 316, 488, 176, 44, 393, 401, 504, 106, 111, 5, 491, 208, 279, 403, 83, 226, 271, 244, 358, 473, 436, 208, 457, 81], [246, 291, 361, 460, 247, 229, 400, 3, 38, 189, 460, 347, 384, 327, 246, 33, 7, 141, 135, 182, 496, 160, 259, 424, 496, 137, 28, 6, 169, 97, 251, 269, 316, 68, 360, 426, 22, 150, 498, 398, 270, 130, 447, 36, 500, 32, 48, 114]]

R = PolynomialRing(ZZ, 'x')
x = R.gen()
R_modq = PolynomialRing(Integers(q), 'x').quotient(x^N - 1, 'xbar')
R_modp = PolynomialRing(Integers(p), 'x').quotient(x^N - 1, 'xbar')

# Pakai lattice yang berbeda — transpose/swap posisi h
# L = [I | H]
#     [0 | qI]
def circulant(h_list, n, mod):
    M = Matrix(ZZ, n, n)
    for i in range(n):
        for j in range(n):
            M[i,j] = int(h_list[(j - i) % n]) % mod
    return M

H = circulant(h, N, q)

# Coba dua orientasi lattice
for orientation in ['A', 'B']:
    if orientation == 'A':
        L = block_matrix(ZZ, [[identity_matrix(N), H],
                               [zero_matrix(ZZ, N, N), q * identity_matrix(N)]])
    else:
        L = block_matrix(ZZ, [[q * identity_matrix(N), zero_matrix(ZZ, N, N)],
                               [H, identity_matrix(ZZ, N)]])
    
    print(f"Orientasi {orientation} - Menjalankan LLL...")
    L_red = L.LLL()
    print("Selesai!")
    
    for i, row in enumerate(L_red.rows()):
        coeffs = list(row)
        first_half = coeffs[:N]
        second_half = coeffs[N:]
        
        for f_half, g_half, label in [(first_half, second_half, 'f=first'), 
                                       (second_half, first_half, 'f=second')]:
            if max(abs(c) for c in f_half) > 2:
                continue
            f_candidate = R(f_half)
            try:
                f_p_inv = R_modp(f_candidate)^(-1)
                f_q_inv = R_modq(f_candidate)^(-1)
                
                # Decrypt semua chunk
                all_bits = []
                for c_list in ct:
                    c_poly = R_modq(R(c_list))
                    a = R_modq(f_candidate) * c_poly
                    a_list = [int(v) for v in a.list()]
                    while len(a_list) < N:
                        a_list.append(0)
                    a_centered = [(v if v <= q//2 else v - q) for v in a_list[:N]]
                    a_modp = R_modp(R(a_centered))
                    m = f_p_inv * a_modp
                    bits = [int(v) % p for v in m.list()]
                    while len(bits) < N:
                        bits.append(0)
                    all_bits.extend(bits[:N])
                
                flag = ''
                for j in range(0, len(all_bits) - 7, 8):
                    byte = all_bits[j:j+8]
                    char_val = int(''.join(str(b) for b in byte), 2)
                    if 32 <= char_val <= 126:
                        flag += chr(char_val)
                    else:
                        flag += '?'
                
                readable = sum(1 for c in flag if c != '?')
                if readable > 5:
                    print(f"\n[{orientation}] Baris {i} {label}: {flag}")
            except:
                pass

print("\nSelesai!")
